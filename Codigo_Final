// ================= SETUP =================
void setup() {
  Serial.begin(115200);

  pinMode(LO_PLUS, INPUT);
  pinMode(LO_MINUS, INPUT);
  pinMode(RESET_WIFI_BUTTON, INPUT_PULLUP);

  startTime = millis();

  configurarOLED();
  configurarWiFi();
  configurarNTP();
  configurarMQTT();
  configurarServidor();

  server.begin();

  Serial.println("Sistema iniciado correctamente");
}

// ================= LOOP =================
void loop() {
  server.handleClient();
  verificarBotonResetWiFi();

  if (!mqttClient.connected()) {
    reconectarMQTT();
  }

  mqttClient.loop();

  tomarMuestraECG();
  publicarMQTT();
}

// ================= OLED =================
void configurarOLED() {
  Wire.begin(21, 22);

  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("Error al iniciar OLED");
    while (true);
  }

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 10);
  display.println("Holter ECG");
  display.println("Iniciando...");
  display.display();

  delay(1000);
  display.clearDisplay();
}

// ================= WIFI =================
void configurarWiFi() {
  WiFiManager wm;

  bool res = wm.autoConnect("Holter-ECG", "12345678");

  if (!res) {
    Serial.println("No se pudo conectar al WiFi");
    ESP.restart();
  }

  Serial.print("WiFi conectado. IP ESP32: ");
  Serial.println(WiFi.localIP());
}

// ================= NTP =================
void configurarNTP() {
  configTime(gmtOffset_sec, daylightOffset_sec, ntpServer);

  Serial.print("Sincronizando hora NTP");

  struct tm timeinfo;
  int intentos = 0;

  while (!getLocalTime(&timeinfo) && intentos < 10) {
    Serial.print(".");
    delay(1000);
    intentos++;
  }

  if (getLocalTime(&timeinfo)) {
    Serial.println("\nHora sincronizada correctamente");
    Serial.println(obtenerTimestamp());
  } else {
    Serial.println("\nNo se pudo sincronizar NTP");
  }
}

String obtenerTimestamp() {
  struct tm timeinfo;

  if (!getLocalTime(&timeinfo)) {
    return "NTP_NOT_SYNCED";
  }

  char buffer[30];
  strftime(buffer, sizeof(buffer), "%Y-%m-%d %H:%M:%S", &timeinfo);

  return String(buffer);
}

// ================= MQTT TLS =================
void configurarMQTT() {
  /*
    Esto activa TLS, pero no valida certificado.
    Para una entrega más segura, lo ideal es usar:
    secureClient.setCACert(root_ca);
  */
  secureClient.setInsecure();

  mqttClient.setServer(MQTT_SERVER, MQTT_PORT);

  Serial.println("MQTT TLS configurado");
}

void reconectarMQTT() {
  unsigned long now = millis();

  if (now - lastMqttReconnectAttempt >= MQTT_RECONNECT_INTERVAL_MS) {
    lastMqttReconnectAttempt = now;

    Serial.print("Conectando a broker MQTT TLS... ");

    if (mqttClient.connect(MQTT_CLIENT_ID)) {
      Serial.println("Conectado");

      publicarEstadoMQTT();
    } else {
      Serial.print("Error MQTT, rc=");
      Serial.println(mqttClient.state());
    }
  }
}

void publicarMQTT() {
  unsigned long now = millis();

  if (mqttClient.connected() && now - lastMqttPublish >= MQTT_INTERVAL_MS) {
    lastMqttPublish = now;

    mqttClient.publish(TOPIC_ECG, String(ecgValue).c_str());
    mqttClient.publish(TOPIC_BPM, String(bpm).c_str());
    mqttClient.publish(TOPIC_BEATS, String(beatCount).c_str());
    mqttClient.publish(TOPIC_ELECTRODES, obtenerEstadoElectrodos().c_str());
    mqttClient.publish(TOPIC_UPTIME, String((millis() - startTime) / 1000).c_str());
    mqttClient.publish(TOPIC_TIMESTAMP, obtenerTimestamp().c_str());

    String payload = generarPayloadJSON();
    mqttClient.publish("holter/ecg/json", payload.c_str());

    Serial.println("Datos publicados por MQTT TLS");
  }
}

void publicarEstadoMQTT() {
  String status = "{";
  status += "\"device\":\"ESP32 Holter ECG\",";
  status += "\"status\":\"online\",";
  status += "\"ip\":\"" + WiFi.localIP().toString() + "\",";
  status += "\"mqtt\":\"connected\",";
  status += "\"tls\":\"enabled\",";
  status += "\"timestamp\":\"" + obtenerTimestamp() + "\"";
  status += "}";

  mqttClient.publish(TOPIC_STATUS, status.c_str(), true);
}

// ================= PAYLOAD JSON =================
String generarPayloadJSON() {
  String json = "{";
  json += "\"ecg\":" + String(ecgValue) + ",";
  json += "\"bpm\":" + String(bpm) + ",";
  json += "\"beatCount\":" + String(beatCount) + ",";
  json += "\"electrodes\":\"" + obtenerEstadoElectrodos() + "\",";
  json += "\"uptime\":" + String((millis() - startTime) / 1000) + ",";
  json += "\"timestamp\":\"" + obtenerTimestamp() + "\",";
  json += "\"mqtt_tls\":true";
  json += "}";

  return json;
}

