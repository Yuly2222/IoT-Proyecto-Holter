// -------- SETUP -------- //
void setup() {
  Serial.begin(115200);

  pinMode(LO_PLUS, INPUT);
  pinMode(LO_MINUS, INPUT);
  pinMode(RESET_WIFI_BUTTON, INPUT_PULLUP);

  startTime = millis();

  WiFiManager wm;
  bool res = wm.autoConnect("Holter-ECG", "12345678");

  if (!res) {
    ESP.restart();
  }

  Serial.print("IP ESP32: ");
  Serial.println(WiFi.localIP());

  configurarServidor();
  server.begin();
}

// -------- LOOP -------- //
void loop() {
  server.handleClient();
  verificarBotonResetWiFi();
  tomarMuestraECG();
}

// -------- TOMA DE MUESTRAS CON BUFFER -------- //
void tomarMuestraECG() {
  unsigned long now = millis();

  if (now - lastSampleTime >= SAMPLE_INTERVAL_MS) {
    lastSampleTime = now;

    ecgValue = analogRead(ECG_PIN);
    detectarLatido(ecgValue);

    ecgBuffer[bufferIndex] = ecgValue;
    bufferIndex++;

    if (bufferIndex >= BUFFER_SIZE) {
      bufferIndex = 0;
      bufferFull = true;
    }
  }
}

// -------- SERVIDOR -------- //
void configurarServidor() {

  server.on("/", HTTP_GET, []() {
    server.send(200, "text/html", htmlPage);
  });

  server.on("/data", HTTP_GET, []() {
    String json = "{";
    json += "\"bpm\":" + String(bpm) + ",";
    json += "\"beatCount\":" + String(beatCount) + ",";
    json += "\"electrodes\":\"" + obtenerEstadoElectrodos() + "\",";
    json += "\"uptime\":" + String((millis() - startTime) / 1000) + ",";
    json += "\"samples\":" + generarBufferJSON();
    json += "}";

    server.send(200, "application/json", json);

    // Limpia el buffer enviado, pero NO borra BPM ni beatCount
    bufferIndex = 0;
    bufferFull = false;
  });

  server.on("/reset-wifi", HTTP_POST, []() {
    server.send(200, "application/json", "{\"message\":\"Reiniciando WiFi...\"}");

    delay(1000);

    WiFiManager wm;
    wm.resetSettings();
    ESP.restart();
  });
}

// -------- CONVERTIR BUFFER A JSON -------- //
String generarBufferJSON() {
  String json = "[";

  int count = bufferFull ? BUFFER_SIZE : bufferIndex;

  for (int i = 0; i < count; i++) {
    json += String(ecgBuffer[i]);

    if (i < count - 1) {
      json += ",";
    }
  }

  json += "]";
  return json;
}

// -------- DETECCIÓN DE LATIDOS -------- //
void detectarLatido(int value) {
  unsigned long now = millis();

  if (value > threshold && !aboveThreshold) {
    aboveThreshold = true;

    unsigned long interval = now - lastBeat;

    if (interval > 300 && interval < 2000) {
      bpm = 60000 / interval;
      beatCount++;
    }

    lastBeat = now;
  }

  if (value < threshold - 200) {
    aboveThreshold = false;
  }
}

// -------- ELECTRODOS -------- //
String obtenerEstadoElectrodos() {
  if (digitalRead(LO_PLUS) || digitalRead(LO_MINUS)) {
    return "Desconectados";
  }

  return "Conectados";
}

// -------- RESET FÍSICO -------- //
void verificarBotonResetWiFi() {
  if (digitalRead(RESET_WIFI_BUTTON) == LOW) {
    delay(3000);

    if (digitalRead(RESET_WIFI_BUTTON) == LOW) {
      WiFiManager wm;
      wm.resetSettings();
      ESP.restart();
    }
  }
}
