#include <WiFi.h>
#include <WebServer.h>
#include <WiFiManager.h>

// -------- PINES -------- //
#define ECG_PIN 34
#define LO_PLUS 32
#define LO_MINUS 33
#define RESET_WIFI_BUTTON 25

WebServer server(80);

// -------- ECG -------- //
int ecgValue = 0;
int bpm = 0;

unsigned long lastBeat = 0;
int threshold = 2200;
bool aboveThreshold = false;

int beatCount = 0;
unsigned long startTime = 0;

// -------- BUFFER ECG -------- //
#define BUFFER_SIZE 120

int ecgBuffer[BUFFER_SIZE];
int bufferIndex = 0;
bool bufferFull = false;

unsigned long lastSampleTime = 0;
const unsigned long SAMPLE_INTERVAL_MS = 1;

// -------- DECLARACIONES -------- //
void detectarLatido(int value);
void configurarServidor();
void verificarBotonResetWiFi();
String obtenerEstadoElectrodos();
void tomarMuestraECG();
String generarBufferJSON();

// -------- HTML -------- //
String htmlPage = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Holter ECG</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

