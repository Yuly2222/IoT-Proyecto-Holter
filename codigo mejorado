<div class="dashboard">
  <div class="card">
    <p>BPM</p>
    <div class="value"><span id="bpm">0</span></div>
  </div>

  <div class="card">
    <p>Pulsaciones</p>
    <div class="value"><span id="beatCount">0</span></div>
  </div>

  <div class="card">
    <p>Electrodos</p>
    <div id="status">OK</div>
  </div>

  <div class="card">
    <p>Tiempo</p>
