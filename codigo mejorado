  <canvas id="ecgChart" width="650" height="260"></canvas>
</div>

<button onclick="resetWiFi()">Reset WiFi</button>

<script>
let chart;
let requesting = false;

const MAX_POINTS = 1000;

const initChart = () => {
  const ctx = document.getElementById('ecgChart').getContext('2d');

  chart = new Chart(ctx, {
    type: 'line',
    data: {
      labels: [],
      datasets: [{
        label: 'ECG',
        data: [],
        borderColor: 'lime',
        borderWidth: 1,
        fill: false,
        tension: 0,
        pointRadius: 0
      }]
    },
    options: {
      animation: false,
      responsive: true,
      scales: {
        x: { display: false },
        y: { min: 0, max: 4095 }
      }
    }
  });
};

const updateData = () => {
  if (requesting) return;
  requesting = true;

  fetch("/data")
    .then(res => res.json())
    .then(data => {
      document.getElementById("bpm").innerText = data.bpm;
      document.getElementById("beatCount").innerText = data.beatCount;
