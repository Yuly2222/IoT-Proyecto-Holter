#include <WiFi.h>
#include <WebServer.h>
#include <WiFiManager.h>
#include <PubSubClient.h>

#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// -------- PINES -------- //
#define ECG_PIN 34
#define LO_PLUS 32
#define LO_MINUS 33
#define RESET_WIFI_BUTTON 25

// -------- OLED -------- //
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

int xPos = 0;

// -------- SERVIDOR WEB -------- //
WebServer server(80);

// -------- MQTT -------- //
WiFiClient espClient;
PubSubClient mqttClient(espClient);

// Cambia esta IP por la IP de tu broker MQTT
const char* MQTT_SERVER = "broker.hivemq.com";
const int MQTT_PORT = 1883;
// 8883 Certificado

const char* MQTT_CLIENT_ID = "holter_ecg_esp32";

const char* TOPIC_ECG = "holter/ecg/value";
const char* TOPIC_BPM = "holter/ecg/bpm";
const char* TOPIC_BEATS = "holter/ecg/beatCount";
const char* TOPIC_ELECTRODES = "holter/ecg/electrodes";
const char* TOPIC_UPTIME = "holter/ecg/uptime";

unsigned long lastMqttPublish = 0;
const unsigned long MQTT_INTERVAL_MS = 500;

unsigned long lastMqttReconnectAttempt = 0;
const unsigned long MQTT_RECONNECT_INTERVAL_MS = 3000;

// -------- VARIABLES ECG -------- //
int ecgValue = 0;
int bpm = 0;

unsigned long lastBeat = 0;
int threshold = 2200;
bool aboveThreshold = false;

int beatCount = 0;
unsigned long startTime = 0;

// -------- BUFFER ECG -------- //
#define BUFFER_SIZE 120

int ecgBuffer[BUFFER_SIZE];
int bufferIndex = 0;
bool bufferFull = false;

unsigned long lastSampleTime = 0;
const unsigned long SAMPLE_INTERVAL_MS = 1;

// -------- DECLARACIONES -------- //
void detectarLatido(int value);
void configurarServidor();
void verificarBotonResetWiFi();
String obtenerEstadoElectrodos();
void tomarMuestraECG();
String generarBufferJSON();
void actualizarOLED(int ecgValue);
void mostrarElectrodosDesconectadosOLED();

void configurarMQTT();
void reconectarMQTT();
void publicarMQTT();

// -------- HTML -------- //
String htmlPage = R"rawliteral(
