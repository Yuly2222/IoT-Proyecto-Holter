// -------- SETUP -------- //
void setup() {
  Serial.begin(115200);

  pinMode(LO_PLUS, INPUT);
  pinMode(LO_MINUS, INPUT);
  pinMode(RESET_WIFI_BUTTON, INPUT_PULLUP);

  startTime = millis();

  // OLED I2C
  Wire.begin(21, 22);

  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("Error al iniciar OLED");
    while (true);
  }

  display.clearDisplay();
  display.setTextSize(2);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 10);
  display.println("Ok");
  display.display();

  delay(1000);
  display.clearDisplay();

  // WiFiManager
  WiFiManager wm;
  bool res = wm.autoConnect("Holter-ECG", "12345678");

  if (!res) {
    ESP.restart();
  }

  Serial.print("IP ESP32: ");
  Serial.println(WiFi.localIP());

  configurarMQTT();

  configurarServidor();
  server.begin();
}

// -------- LOOP -------- //
void loop() {
  server.handleClient();
  verificarBotonResetWiFi();

  if (!mqttClient.connected()) {
    reconectarMQTT();
  }

  mqttClient.loop();

  tomarMuestraECG();
  publicarMQTT();
}

// -------- MQTT -------- //
void configurarMQTT() {
  mqttClient.setServer(MQTT_SERVER, MQTT_PORT);
}

void reconectarMQTT() {
  unsigned long now = millis();

  if (now - lastMqttReconnectAttempt >= MQTT_RECONNECT_INTERVAL_MS) {
    lastMqttReconnectAttempt = now;

    Serial.print("Conectando a MQTT... ");

    if (mqttClient.connect(MQTT_CLIENT_ID)) {
      Serial.println("Conectado");
    } else {
      Serial.print("Error MQTT, rc=");
      Serial.println(mqttClient.state());
    }
  }
}

void publicarMQTT() {
  unsigned long now = millis();

  if (mqttClient.connected() && now - lastMqttPublish >= MQTT_INTERVAL_MS) {
    lastMqttPublish = now;

    mqttClient.publish(TOPIC_ECG, String(ecgValue).c_str());
    mqttClient.publish(TOPIC_BPM, String(bpm).c_str());
    mqttClient.publish(TOPIC_BEATS, String(beatCount).c_str());
    mqttClient.publish(TOPIC_ELECTRODES, obtenerEstadoElectrodos().c_str());
    mqttClient.publish(TOPIC_UPTIME, String((millis() - startTime) / 1000).c_str());

    Serial.println("Datos publicados por MQTT");
  }
}

// -------- TOMA DE MUESTRAS -------- //
void tomarMuestraECG() {
  unsigned long now = millis();

  if (now - lastSampleTime >= SAMPLE_INTERVAL_MS) {
    lastSampleTime = now;

    if (digitalRead(LO_PLUS) || digitalRead(LO_MINUS)) {
      mostrarElectrodosDesconectadosOLED();
      return;
    }

    ecgValue = analogRead(ECG_PIN);
    detectarLatido(ecgValue);

    ecgBuffer[bufferIndex] = ecgValue;
    bufferIndex++;

    if (bufferIndex >= BUFFER_SIZE) {
      bufferIndex = 0;
      bufferFull = true;
    }

    actualizarOLED(ecgValue);
  }
}

// -------- OLED ECG -------- //
void actualizarOLED(int ecgValue) {
  int y = map(ecgValue, 0, 4095, SCREEN_HEIGHT, 0);

  display.drawPixel(xPos, y, SSD1306_WHITE);

  xPos++;

  if (xPos >= SCREEN_WIDTH) {
    xPos = 0;
    display.clearDisplay();
  }

  display.display();
}

void mostrarElectrodosDesconectadosOLED() {
  display.clearDisplay();

  display.setCursor(0, 20);
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  display.println("Electrodos");
  display.println("desconectados");

  display.display();

  delay(300);
}

// -------- SERVIDOR -------- //
void configurarServidor() {

  server.on("/", HTTP_GET, []() {
    server.send(200, "text/html", htmlPage);
  });

  server.on("/data", HTTP_GET, []() {
    String json = "{";
    json += "\"bpm\":" + String(bpm) + ",";
    json += "\"beatCount\":" + String(beatCount) + ",";
    json += "\"electrodes\":\"" + obtenerEstadoElectrodos() + "\",";
    json += "\"uptime\":" + String((millis() - startTime) / 1000) + ",";
    json += "\"samples\":" + generarBufferJSON();
    json += "}";

    server.send(200, "application/json", json);

    bufferIndex = 0;
    bufferFull = false;
  });

  server.on("/reset-wifi", HTTP_POST, []() {
    server.send(200, "application/json", "{\"message\":\"Reiniciando WiFi...\"}");

    delay(1000);

    WiFiManager wm;
    wm.resetSettings();
    ESP.restart();
  });
}

// -------- BUFFER A JSON -------- //
String generarBufferJSON() {
  String json = "[";

  int count = bufferFull ? BUFFER_SIZE : bufferIndex;

  for (int i = 0; i < count; i++) {
    json += String(ecgBuffer[i]);

    if (i < count - 1) {
      json += ",";
    }
  }

  json += "]";
  return json;
}

// -------- LATIDOS -------- //
void detectarLatido(int value) {
  unsigned long now = millis();

  if (value > threshold && !aboveThreshold) {
    aboveThreshold = true;

    unsigned long interval = now - lastBeat;

    if (interval > 300 && interval < 2000) {
      bpm = 60000 / interval;
      beatCount++;
    }

    lastBeat = now;
  }

  if (value < threshold - 200) {
    aboveThreshold = false;
  }
}

// -------- ELECTRODOS -------- //
String obtenerEstadoElectrodos() {
  if (digitalRead(LO_PLUS) || digitalRead(LO_MINUS)) {
    return "Desconectados";
  }

  return "Conectados";
}

// -------- RESET FÍSICO -------- //
void verificarBotonResetWiFi() {
  if (digitalRead(RESET_WIFI_BUTTON) == LOW) {
    delay(3000);

    if (digitalRead(RESET_WIFI_BUTTON) == LOW) {
      WiFiManager wm;
      wm.resetSettings();
      ESP.restart();
    }
  }
}
